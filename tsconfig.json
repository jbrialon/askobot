{
  "extends": ["@tsconfig/node-lts/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "sourceMap": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "checkJs": false
  },
  "include": ["app.js", "config.js", "db", "app"],
  "exclude": ["dist", "node_modules", "front"]
}
